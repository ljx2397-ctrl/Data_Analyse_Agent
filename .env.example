# .env.example
# 复制为 .env 并按需修改（标准 KEY=value 格式，不要用 set 和引号）。

# ── LLM API Key（可选，启动后也可在网页『🤖 大模型配置』中填写）──────
# 阿里云 DashScope，获取地址：https://bailian.console.aliyun.com/
# 不填也可启动服务，进入网页后在右上角『🤖 大模型配置』中填写即可。
DASHSCOPE_API_KEY=PUT_YOUR_KEY_HERE

# ── Redis（可选，未设置时自动降级为本地文件持久化，重启不丢失）─────
# 生产环境建议配置真实 Redis：
# REDIS_URL=redis://127.0.0.1:6379/0

# ── 对象存储（可选，默认 local 本地文件系统）──────────────────────────
# 后续可扩展 minio：
# STORAGE_BACKEND=minio
